              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": false,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "Running = progress above 0%. Machine state (text) sensors are not numeric, so the exporter may not export them."
    },
    {
      "id": 10,
      "title": "Sprinkler zones",
