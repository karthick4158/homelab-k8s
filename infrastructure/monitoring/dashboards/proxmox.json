        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": "Every Proxmox storage (local, local-lvm, PVEBackUpDisk, ...) by name from pve_storage_info."
    },
    {
      "id": 13,
      "title": "Storage used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pve_disk_usage_bytes{id=~\"storage/.*\"} * on(id) group_left(storage) pve_storage_info",
          "legendFormat": "{{storage}}",
          "datasource": {
            "type": "prometheus",
